# Ollama
try:
    import ollama
except:
    ollama = None

# Tools registry - robusto con fallback
try:
    from tools import load_tools
except ImportError as e:
    print(f"⚠ No se pudo importar tools.load_tools: {e}")
    print(f"  Buscando en: {SCRIPT_DIR / 'tools'}")
    import importlib.util
    import traceback

    def load_tools():
        definitions = []
        executors = {}
        tools_dir = SCRIPT_DIR / "tools"
        if not tools_dir.exists():
            print(f"⚠ Carpeta tools no existe en {tools_dir}")
            return definitions, executors

        print(f"🔍 Cargando tools desde fallback: {tools_dir}")
        for file in tools_dir.glob("*.py"):
            if file.name.startswith("_") or file.name == "__init__.py":
                continue
            try:
                spec = importlib.util.spec_from_file_location(file.stem, file)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                if hasattr(mod, "TOOL_DEFINITION") and hasattr(mod, "execute"):
                    definitions.append(mod.TOOL_DEFINITION)
                    executors[mod.TOOL_DEFINITION["function"]["name"]] = mod.execute
                    print(f"✓ Tool cargado (fallback): {mod.TOOL_DEFINITION['function']['name']}")
            except Exception as ex:
                print(f"✗ Error cargando {file.name}: {ex}")
                traceback.print_exc()
        return definitions, executors


VISION_MODELS = ["llava", "bakllava", "gemma3", "qwen2-vl", "qwen2.5-vl", "llama3.2-vision", "minicpm-v", "moondream", "vision"]
VISION_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}

def is_vision_model(name: str) -> bool:
    low = name.lower()
    return any(v in low for v in VISION_MODELS)

def encode_image(path: str) -> Optional[str]:
    try:
        with open(path, "rb") as f:
            return base64.b64encode(f.read()).decode("utf-8")
    except:
        return None

# ================= WORKER =================
class OllamaWorker(QThread):
    chunk_received = Signal(str)  # delta answer
    thinking_chunk = Signal(str)  # thinking delta
    tool_call_detected = Signal(str, dict)  # name, args
    tool_result_ready = Signal(str, str)  # name, result
    thinking_started = Signal()
    thinking_finished = Signal(str)
    final_answer = Signal(str, str)  # answer, thinking
    error_occurred = Signal(str)
    status_update = Signal(str)

    def __init__(self, model: str, history: List[Dict], tools_def: List[Dict], executors: Dict, enable_tools: bool = True):
        super().__init__()
        self.model = model
        self.history = history.copy()
        self.tools_def = tools_def if enable_tools else []
        self.executors = executors
        self.enable_tools = enable_tools
        self._stop = False

    def stop(self):
        self._stop = True

    def run(self):
        if ollama is None:
            self.error_occurred.emit("ollama no instalado. pip install ollama")
            return

        client = ollama.Client()
        try:
            # FASE 1: Tools loop (hasta 3 iteraciones)
            current_history = self.history.copy()
            tool_iterations = 0

            while self.enable_tools and tool_iterations < 3 and not self._stop:
                self.status_update.emit(f"Analizando si necesita herramientas... (iter {tool_iterations+1})")
                resp = client.chat(model=self.model, messages=current_history, tools=self.tools_def, stream=False)
                msg = resp.get('message', {})
                tool_calls = msg.get('tool_calls', [])

                if tool_calls:
                    for tc in tool_calls:
                        func = tc.get('function', {})
                        name = func.get('name','')
                        args = func.get('arguments', {})
                        if isinstance(args, str):
                            try:
                                args = json.loads(args)
                            except:
                                args = {"query": args}

                        self.tool_call_detected.emit(name, args)

                        executor = self.executors.get(name)
                        if executor:
                            try:
                                result = executor(**args) if args else executor()
                            except Exception as e:
                                result = f"Error ejecutando {name}: {e}"
                        else:
                            result = f"Tool {name} no encontrado"

                        self.tool_result_ready.emit(name, result)

                        current_history.append(msg)
                        current_history.append({"role": "tool", "content": str(result)})

                    tool_iterations += 1
                    continue
                else:
                    break

            # FASE 2: Streaming final con deteccion de think
            self.status_update.emit("Generando respuesta...")
            raw_accum = ""
            thinking_content = ""
            answer_content = ""
            has_think = False
            think_closed = False
            last_tool_result = ""

            for m in reversed(current_history):
                if m.get("role") == "tool":
                    last_tool_result = str(m.get("content", ""))
                    break

            stream = client.chat(model=self.model, messages=current_history, stream=True)

            for chunk in stream:
                if self._stop:
                    break
                if chunk.get('done'):
                    break

                thinking_delta = chunk.get('message', {}).get('thinking', '')
                if thinking_delta and not has_think:
                    has_think = True
                    self.thinking_started.emit()
                if thinking_delta and has_think and not think_closed:
                    self.thinking_chunk.emit(thinking_delta[:2000])
                    continue

                delta = chunk.get('message', {}).get('content', '')
                if not delta:
                    continue

                raw_accum += delta

                if "<<thinking>>" in raw_accum and not has_think:
                    has_think = True
                    self.thinking_started.emit()

                if has_think and not think_closed:
                    if "</thinking>>" in raw_accum:
                        think_closed = True
                        m = re.search(r"<<thinking>>(.*?)</thinking>>", raw_accum, re.DOTALL)
                        if m:
                            thinking_content = m.group(1).strip()
                            answer_content = re.sub(r"<<thinking>>.*?</thinking>>", "", raw_accum, flags=re.DOTALL)
                            self.thinking_finished.emit(thinking_content)
                            if answer_content.strip():
                                self.chunk_received.emit(answer_content)
                        else:
                            parts = raw_accum.split("</thinking>>", 1)
                            thinking_content = parts[0].replace("<<thinking>>", "").strip()
                            self.thinking_finished.emit(thinking_content)
                            answer_content = parts[1] if len(parts) > 1 else ""
                            if answer_content.strip():
                                self.chunk_received.emit(answer_content)
                    else:
                        think_part = raw_accum.split("<<thinking>>")[-1]
                        self.thinking_chunk.emit(think_part[:2000])
                else:
                    if not has_think:
                        self.chunk_received.emit(delta)
                        answer_content += delta

            if has_think:
                m = re.search(r"<<thinking>>.*?</thinking>>(.*)", raw_accum, re.DOTALL)
                final_ans = m.group(1).strip() if m else re.sub(r"<<thinking>>.*?</thinking>>", "", raw_accum, flags=re.DOTALL).strip()
                if not final_ans:
                    final_ans = answer_content.strip()
            else:
                final_ans = raw_accum.strip()

            if not final_ans and last_tool_result:
                final_ans = last_tool_result

            self.final_answer.emit(final_ans, thinking_content)

        except Exception as e:
            self.error_occurred.emit(str(e))

# ================= UI WIDGETS =================
class ThinkingBlockWidget(QFrame):
    """Bloque de pensamiento colapsable: encabezado + cuerpo oculto por defecto."""
    def __init__(self):
        super().__init__()
        self.setObjectName("thinkingBlock")
        self.setStyleSheet("""
            #thinkingBlock {
                background: transparent;
                border: none;
                border-radius: 0;
                margin: 0;
            }
        """)
        self.is_expanded = False  # colapsado por defecto
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)

        # Encabezado: título + botón Ver/Ocultar
        header = QHBoxLayout()
        header.setContentsMargins(0, 0, 0, 0)
        header.setSpacing(8)

        self.label = QLabel("💭 Pensamiento completado")
        self.label.setStyleSheet("color: #c9a86a; font-weight: bold; font-size: 12px;")
        header.addWidget(self.label)
        header.addStretch()

        self.toggle_btn = QPushButton("Ver")
        self.toggle_btn.setFixedSize(56, 22)
        self.toggle_btn.setStyleSheet("""
            QPushButton {
                background: #3a3a44;
                color: #c9a86a;
                border: 1px solid #5a4a2a;
                border-radius: 4px;
                font-size: 11px;
                font-weight: bold;
            }
            QPushButton:hover { background: #4a4a54; }
        """)
        self.toggle_btn.clicked.connect(self.toggle)
        header.addWidget(self.toggle_btn)

        layout.addLayout(header)

        # Cuerpo: contenido del pensamiento (oculto al inicio)
        self.body = QTextBrowser()
        self.body.setMaximumHeight(200)
        self.body.setStyleSheet("""
            QTextBrowser {
                background: #1a1a20;
                color: #a0a0b0;
                border: 1px solid #3a3a44;
                border-top: none;
                border-radius: 0 0 6px 6px;
                font-size: 12px;
                font-family: 'Consolas', 'Monaco', monospace;
                selection-background-color: #c9a86a;
            }
        """)
        self.body.setOpenExternalLinks(False)
        self.body.setVisible(False)
        layout.addWidget(self.body)

    def start(self):
        self.show()
        self.body.setVisible(False)
        self.label.setText("🧠 Razonando...")
        self.body.setMarkdown("_Iniciando razonamiento..._")
        self._notify_parent()

    def update_content(self, text: str):
        self.show()
        self.body.setVisible(True)
        self.label.setText("🧠 Razonando...")
        self.body.setMarkdown(text[:3000])
        self._notify_parent()

    def finish(self, text: str):
        self.label.setText("💭 Pensamiento completado")
        self.body.setVisible(True)
        self.body.setMarkdown(text)
        self._notify_parent()

    def _notify_parent(self):
        parent = self.parentWidget()
        if parent:
            parent.updateGeometry()
            if parent.layout():
                parent.layout().activate()

    def toggle(self):
        if self.is_expanded:
            self.body.setVisible(False)
            self.toggle_btn.setText("Ver")
            self.is_expanded = False
        else:
            self.body.setVisible(True)
            self.toggle_btn.setText("Ocultar")
            self.is_expanded = True
        self._notify_parent()


class ToolBlockWidget(QFrame):
    """Bloque de herramientas: filas limpias por tool, sin JSON crudo."""
    def __init__(self):
        super().__init__()
        self.setObjectName("toolBlock")
        self.setStyleSheet("""
            #toolBlock {
                background: transparent;
                border: none;
                border-radius: 0;
                margin: 0;
            }
        """)
        self.is_expanded = False  # colapsado por defecto
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)

        # Encabezado: título + botón Ver/Ocultar
        header = QHBoxLayout()
        header.setContentsMargins(0, 0, 0, 0)
        header.setSpacing(8)

        self.label = QLabel("🔧 Tools completado")
        self.label.setStyleSheet("color: #7bc88a; font-weight: bold; font-size: 12px;")
        header.addWidget(self.label)
        header.addStretch()

        self.toggle_btn = QPushButton("Ver")
        self.toggle_btn.setFixedSize(56, 22)
        self.toggle_btn.setStyleSheet("""
            QPushButton {
                background: #3a3a44;
                color: #7bc88a;
                border: 1px solid #3a5a40;
                border-radius: 4px;
                font-size: 11px;
                font-weight: bold;
            }
            QPushButton:hover { background: #4a4a54; }
        """)
        self.toggle_btn.clicked.connect(self.toggle)
        header.addWidget(self.toggle_btn)

        layout.addLayout(header)

        # Cuerpo: filas de herramientas (oculto al inicio)
        self.body = QVBoxLayout()
        self.body.setContentsMargins(0, 0, 0, 0)
        self.body.setSpacing(6)

        self.body_widget = QFrame()
        self.body_widget.setLayout(self.body)
        self.body_widget.setStyleSheet("""
            QFrame {
                background: #121a14;
                border: 1px solid #2a2a30;
                border-top: none;
                border-radius: 0 0 6px 6px;
            }
        """)
        self.body_widget.setVisible(False)
        layout.addWidget(self.body_widget)

        self._entries = []

    def _notify_parent(self):
        parent = self.parentWidget()
        if parent:
            parent.updateGeometry()
            if parent.layout():
                parent.layout().activate()

    def add_call(self, name: str, args: dict):
        """Crea una fila limpia por tool ejecutado."""
        row = QFrame()
        row.setStyleSheet("""
            QFrame {
                background: transparent;
                border: none;
                border-bottom: 1px solid #2a2a30;
                padding: 4px 0;
            }
        """)
        row_layout = QHBoxLayout(row)
        row_layout.setContentsMargins(8, 2, 8, 2)
        row_layout.setSpacing(8)

        icon = QLabel("🔧")
        icon.setFixedSize(16, 16)
        row_layout.addWidget(icon)

        name_lbl = QLabel(f"{name}")
        name_lbl.setStyleSheet("color: #e0e0e0; font-weight: bold; font-size: 12px;")
        row_layout.addWidget(name_lbl)

        status_lbl = QLabel("ejecutando…")
        status_lbl.setStyleSheet("color: #c9a86a; font-size: 11px; font-style: italic;")
        row_layout.addWidget(status_lbl)
        row_layout.addStretch()

        ver_btn = QPushButton("Ver")
        ver_btn.setFixedSize(44, 22)
        ver_btn.setStyleSheet("""
            QPushButton {
                background: #3a3a44;
                color: #e0e0e0;
                border: 1px solid #4a4a54;
                border-radius: 4px;
                font-size: 10px;
            }
            QPushButton:hover { background: #4a4a54; }
        """)
        ver_btn.hide()
        row_layout.addWidget(ver_btn)

        self.body.addWidget(row)
        self._entries.append({
            "name": name,
            "args": args,
            "result": "",
            "row": row,
            "status_lbl": status_lbl,
            "ver_btn": ver_btn,
            "expanded": False,
            "detail_widget": None,
        })
        self.show()
        self._notify_parent()

    def add_result(self, name: str, result: str):
        """Actualiza la fila del tool con su resultado y resumen."""
        for entry in self._entries:
            if entry["name"] == name:
                entry["result"] = result
                summary = self._make_summary(name, result)
                entry["status_lbl"].setText(summary)
                entry["status_lbl"].setStyleSheet("color: #7bc88a; font-size: 11px;")
                entry["ver_btn"].show()
                try:
                    entry["ver_btn"].clicked.disconnect()
                except TypeError:
                    pass
                entry["ver_btn"].clicked.connect(lambda _, n=name: self._toggle_detail(n))
                break
        self._notify_parent()

    def _make_summary(self, name: str, result: str) -> str:
        """Genera un resumen legible sin JSON crudo."""
        if not result or result.startswith("Error"):
            return "error"
        r = result.strip()
        if name == "web_search":
            parts = [p.strip() for p in r.split("---") if p.strip()]
            return f"{len(parts)} resultados encontrados"
        if name == "get_weather":
            return r[:60] + ("…" if len(r) > 60 else "")
        if name == "get_current_time":
            return r[:60] + ("…" if len(r) > 60 else "")
        if name == "system_info":
            return "info del sistema"
        if name == "calculator":
            return r[:60] + ("…" if len(r) > 60 else "")
        if name == "read_file":
            return "archivo leído"
        if name == "speak":
            return "reproducido por voz"
        if name == "listen":
            return "texto dictado"
        return r[:60] + ("…" if len(r) > 60 else "")

    def _toggle_detail(self, name: str):
        """Muestra/oculta el detalle formateado de un tool."""
        for entry in self._entries:
            if entry["name"] == name:
                if entry["expanded"]:
                    if entry.get("detail_widget"):
                        entry["detail_widget"].setVisible(False)
                        entry["detail_widget"].deleteLater()
                        entry["detail_widget"] = None
                    entry["expanded"] = False
                    entry["ver_btn"].setText("Ver")
                else:
                    detail = QTextBrowser()
                    detail.setOpenExternalLinks(True)
                    # Render markdown a HTML para negritas, listas y links clicables
                    html = _md.markdown(entry["result"], extensions=["extra"])
                    detail.setHtml(html)
                    detail.setStyleSheet("""
                        QTextBrowser {
                            background: #1a1a20;
                            color: #E8E8EA;
                            border: 1px solid #3a3a44;
                            border-radius: 4px;
                            font-size: 12px;
                            line-height: 1.5;
                            padding: 8px;
                            selection-background-color: #7bc88a;
                        }
                        QTextBrowser a { color: #8ab4f8; text-decoration: underline; }
                    """)
                    detail.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
                    detail.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
                    detail.setMaximumHeight(250)
                    idx = self.body.indexOf(entry["row"])
                    self.body.insertWidget(idx + 1, detail)
                    entry["detail_widget"] = detail
                    entry["expanded"] = True
                    entry["ver_btn"].setText("Ocultar")
                self._notify_parent()
                break

    def finish(self):
        self.label.setText("🔧 Tools completado")
        self.body_widget.setVisible(True)
        self._notify_parent()

    def toggle(self):
        if self.is_expanded:
            self.body_widget.setVisible(False)
            self.toggle_btn.setText("Ver")
            self.is_expanded = False
        else:
            self.body_widget.setVisible(True)
            self.toggle_btn.setText("Ocultar")
            self.is_expanded = True
        self._notify_parent()


class MessageBubble(QFrame):
    """Burbuja de mensaje con jerarquía de 3 niveles para OLLAMA."""
    def __init__(self, role: str, content: str, images: List[str] = None):
        super().__init__()
        self.role = role
        self.full_text = content or ""
        self.images = images or []

        self.setObjectName("messageBubble")
        self.setStyleSheet("""
            QFrame#messageBubble {
                background: transparent;
                border: none;
                border-radius: 0;
            }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)

        # ================================================================
        # Nivel 1: Header OLLAMA (solo avatar + nombre, sin caja)
        # ================================================================
        header = QHBoxLayout()
        header.setContentsMargins(0, 0, 0, 0)
        header.setSpacing(6)

        avatar = QLabel()
        avatar.setFixedSize(24, 24)
        avatar.setAlignment(Qt.AlignCenter)
        if role == "user":
            avatar.setText("👤")
            avatar.setStyleSheet("""
                QLabel {
                    background: #8ab4f8;
                    color: #000;
                    border-radius: 12px;
                    font-size: 12px;
                    font-weight: bold;
                }
            """)
            header.addStretch()
            header.addWidget(avatar)
            role_label = QLabel("TÚ")
            role_label.setStyleSheet("color: #8ab4f8; font-weight: bold; font-size: 11px;")
            header.addWidget(role_label)
        else:
            avatar.setText("🤖")
            avatar.setStyleSheet("""
                QLabel {
                    background: #81c995;
                    color: #000;
                    border-radius: 12px;
                    font-size: 12px;
                    font-weight: bold;
                }
            """)
            header.addWidget(avatar)
            role_label = QLabel("OLLAMA")
            role_label.setStyleSheet("color: #81c995; font-weight: bold; font-size: 11px;")
            header.addWidget(role_label)
            header.addStretch()

        layout.addLayout(header)

        # ================================================================
        # Nivel 2: Zona de proceso (Think + Tools) o burbuja de usuario
        # ================================================================
        if role == "user":
            # Usuario: burbuja directa con imágenes y texto
            bubble_container = QHBoxLayout()
            bubble_container.setContentsMargins(0, 0, 0, 0)
            bubble_container.setSpacing(0)

            self.bubble = QFrame()
            self.bubble.setObjectName("bubble")
            self.bubble.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
            self.bubble.setMinimumWidth(280)
            self.bubble.setStyleSheet("""
                QFrame#bubble {
                    background: #1e1e22;
                    border: 1px solid #3a3a44;
                    border-radius: 12px;
                }
            """)

            bubble_layout = QVBoxLayout(self.bubble)
            bubble_layout.setContentsMargins(14, 16, 14, 16)
            bubble_layout.setSpacing(10)

            if self.images:
                for img_path in self.images:
                    try:
                        pix = QPixmap(img_path)
                        if not pix.isNull():
                            img_lbl = QLabel()
                            img_lbl.setPixmap(pix.scaled(240, 240, Qt.KeepAspectRatio, Qt.SmoothTransformation))
                            img_lbl.setStyleSheet("border-radius: 6px; background: #0e0e10; padding: 4px;")
                            bubble_layout.addWidget(img_lbl)
                        name_lbl = QLabel(f"📎 {Path(img_path).name}")
                        name_lbl.setStyleSheet("color: #8ab4f8; font-size: 11px; font-weight: bold;")
                        bubble_layout.addWidget(name_lbl)
                    except:
                        pass

            self.text_browser = QTextBrowser()
            self.text_browser.setOpenExternalLinks(True)
            self.text_browser.setMarkdown(content or "")
            self.text_browser.setStyleSheet("""
                QTextBrowser {
                    background: transparent;
                    border: none;
                    color: #E8E8EA;
                    font-size: 14px;
                    line-height: 1.6;
                    padding: 0;
                    selection-background-color: #8ab4f8;
                }
                QTextBrowser a { color: #8ab4f8; text-decoration: underline; }
            """)
            self.text_browser.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
            self.text_browser.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
            bubble_layout.addWidget(self.text_browser)

            bubble_container.addStretch()
            bubble_container.addWidget(self.bubble, 0, Qt.AlignRight)
            layout.addLayout(bubble_container)

        else:
            # OLLAMA: Nivel 2 - Zona de proceso (fondo sutil, ancho completo)
            process_zone = QFrame()
            process_zone.setObjectName("processZone")
            process_zone.setStyleSheet("""
                #processZone {
                    background: #16161a;
                    border: none;
                    border-radius: 0;
                }
            """)
            process_layout = QVBoxLayout(process_zone)
            process_layout.setContentsMargins(0, 0, 0, 0)
            process_layout.setSpacing(0)

            self.thinking_block = ThinkingBlockWidget()
            self.tool_block = ToolBlockWidget()

            process_layout.addWidget(self.thinking_block)
            process_layout.addWidget(self.tool_block)

            layout.addWidget(process_zone)

            # Nivel 3 - Burbuja de respuesta final (propio fondo, padding)
            self.bubble = QFrame()
            self.bubble.setObjectName("responseBubble")
            self.bubble.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
            self.bubble.setMinimumWidth(280)
            self.bubble.setStyleSheet("""
                QFrame#responseBubble {
                    background: #15151a;
                    border: 1px solid #2a2a30;
                    border-radius: 12px;
                }
            """)

            bubble_layout = QVBoxLayout(self.bubble)
            bubble_layout.setContentsMargins(14, 16, 14, 16)
            bubble_layout.setSpacing(8)

            self.text_browser = QTextBrowser()
            self.text_browser.setOpenExternalLinks(True)
            self.text_browser.setMarkdown(content or "")
            self.text_browser.setStyleSheet("""
                QTextBrowser {
                    background: transparent;
                    border: none;
                    color: #E8E8EA;
                    font-size: 14px;
                    line-height: 1.6;
                    padding: 0;
                    selection-background-color: #8ab4f8;
                }
                QTextBrowser a { color: #8ab4f8; text-decoration: underline; }
            """)
            self.text_browser.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
            self.text_browser.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
            bubble_layout.addWidget(self.text_browser)

            self.footer = QLabel("")
            self.footer.setStyleSheet("color: #888; font-style: italic; font-size: 10px; margin-top: 4px;")
            footer_row = QHBoxLayout()
            footer_row.setContentsMargins(0, 0, 0, 0)
            footer_row.addWidget(self.footer)
            footer_row.addStretch()
            bubble_layout.addLayout(footer_row)

            self.tts_btn = QPushButton("🔊")
            self.tts_btn.setFixedSize(28, 28)
            self.tts_btn.setToolTip("Leer respuesta en voz alta (TTS)")
            self.tts_btn.setStyleSheet("""
                QPushButton {
                    background: #3a3a44;
                    color: #e0e0e0;
                    border: none;
                    border-radius: 6px;
                    font-size: 14px;
                }
                QPushButton:hover { background: #4a4a54; }
            """)
            self.tts_btn.hide()
            self.tts_btn.clicked.connect(lambda: self.speak_response(self.full_text))

            footer_row.insertWidget(0, self.tts_btn)

            bubble_container = QHBoxLayout()
            bubble_container.setContentsMargins(0, 0, 0, 0)
            bubble_container.setSpacing(0)
            bubble_container.addWidget(self.bubble, 0, Qt.AlignLeft)
            bubble_container.addStretch()
            layout.addLayout(bubble_container)

    def setAnswer(self, text: str):
        self.full_text = text
        self.text_browser.setMarkdown(text)

    def appendAnswer(self, delta: str):
        self.full_text += delta
        self.text_browser.setMarkdown(self.full_text)

    def finishAnswer(self, answer: str, thinking: str):
        self.text_browser.setMarkdown(answer)
        if hasattr(self, 'thinking_block'):
            self.thinking_block.finish(thinking)
        if hasattr(self, 'tool_block'):
            self.tool_block.finish()
        if hasattr(self, 'footer'):
            self.footer.setText(f"Completado | {len(answer.split())} palabras")
        self.updateGeometry()
        if self.layout():
            self.layout().activate()

    def showTTS(self):
        if hasattr(self, 'tts_btn'):
            self.tts_btn.show()


class ChatContainer(QWidget):
    def __init__(self):
        super().__init__()
        self.layout = QVBoxLayout(self)
        self.layout.setContentsMargins(12, 8, 12, 8)
        self.layout.setSpacing(10)
        self.layout.setAlignment(Qt.AlignTop)

    def add_message_widget(self, widget: MessageBubble):
        self.layout.addWidget(widget)

    def clear_except_welcome(self):
        while self.layout.count() > 1:
            item = self.layout.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()


class TitleBar(QFrame):
    """Barra de título personalizada con botones de ventana (sin header nativo)"""
    def __init__(self, parent: QMainWindow):
        super().__init__(parent)
        self.window = parent
        self.setFixedHeight(40)
        self.setStyleSheet("""
            QFrame {
                background: #16161a;
                border-bottom: 1px solid #2a2a30;
            }
            QLabel {
                color: #e0e0e0;
                font-size: 13px;
                font-weight: bold;
                padding-left: 12px;
            }
            QPushButton {
                background: transparent;
                color: #e0e0e0;
                border: none;
                font-size: 16px;
                font-weight: bold;
            }
            QPushButton:hover {
                background: #2a2a30;
                border-radius: 6px;
            }
            QPushButton#closeBtn:hover {
                background: #4a1a1a;
                color: #ff6b6b;
            }
        """)
        self._pressing = False
        self._start_pos = None

        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        self.title_label = QLabel("Ollama GUI - Lubuntu Edition")
        layout.addWidget(self.title_label)
        layout.addStretch()

        self.min_btn = QPushButton("−")
        self.min_btn.setFixedSize(40, 40)
        self.min_btn.clicked.connect(self.window.showMinimized)
        layout.addWidget(self.min_btn)

        self.max_btn = QPushButton("□")
        self.max_btn.setFixedSize(40, 40)
        self.max_btn.clicked.connect(self.toggle_maximize)
        layout.addWidget(self.max_btn)

        self.close_btn = QPushButton("×")
        self.close_btn.setObjectName("closeBtn")
        self.close_btn.setFixedSize(40, 40)
        self.close_btn.clicked.connect(self.window.close)
        layout.addWidget(self.close_btn)

    def toggle_maximize(self):
        if self.window.isMaximized():
            self.window.showNormal()
            self.max_btn.setText("□")
        else:
            self.window.showMaximized()
            self.max_btn.setText("❐")

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._pressing = True
            self._start_pos = event.globalPosition().toPoint()
            super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self._pressing and self._start_pos is not None:
            diff = event.globalPosition().toPoint() - self._start_pos
            self.window.move(self.window.pos() + diff)
            self._start_pos = event.globalPosition().toPoint()
            event.accept()
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        self._pressing = False
        super().mouseReleaseEvent(event)


# ================= MAIN WINDOW =================
class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Ollama GUI - Lubuntu Edition")
        self.setAcceptDrops(True)
        # Ventana sin borde nativo (barra de título personalizada)
        self.setWindowFlags(Qt.FramelessWindowHint)

        # Tamaño inicial dinámico basado en availableGeometry
        screen = QApplication.primaryScreen()
        avail = screen.availableGeometry()
        w = min(1150, int(avail.width() * 0.92))
        h = min(750, int(avail.height() * 0.92))
        self.resize(w, h)
        self.setMinimumSize(860, 520)

        self.move(
            avail.x() + (avail.width() - w) // 2,
            avail.y() + (avail.height() - h) // 2,
        )

        self.chat_history: List[Dict] = []
        self.current_model = "llama3.1"
        self.models: List[str] = []
        self.attached_images: List[str] = []
        self.worker: Optional[OllamaWorker] = None
        self._answer_buffer: str = ""

        # Cargar tools
        self.tools_def, self.executors = load_tools()
        print(f"Tools cargados: {list(self.executors.keys())}")

        # =====================================================================
        # ESTRUCTURA UNICA: MainWindow -> centralWidget -> QSplitter(2 widgets)
        # =====================================================================
        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        # Barra de título personalizada
        self.title_bar = TitleBar(self)
        main_layout.addWidget(self.title_bar)

        # QSplitter con SOLO 2 widgets: sidebar y central
        splitter = QSplitter(Qt.Horizontal)
        splitter.setChildrenCollapsible(False)
        splitter.setHandleWidth(2)
        splitter.setStyleSheet("""
            QSplitter::handle {
                background: #2a2a30;
                width: 2px;
            }
            QSplitter::handle:hover {
                background: #8ab4f8;
            }
        """)
        main_layout.addWidget(splitter, 1)

        # ---------------------------------------------------------------
        # 1. SIDEBAR: ancho fijo 280px, con QScrollArea interno
        # ---------------------------------------------------------------
        sidebar = QFrame()
        sidebar.setFixedWidth(280)
        sidebar.setStyleSheet("""
            QFrame {
